# Docker Compose Environment Variables
# Copy to .env before running docker compose

POSTGRES_USER=prowork
POSTGRES_PASSWORD=change_this_secure_password_123
POSTGRES_DB=prowork
POSTGRES_PORT=5432

REDIS_PASSWORD=change_this_redis_password_456
REDIS_PORT=6379

API_PORT=3010
ADMIN_PORT=3001
EXPLORER_PORT=3002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_PASSWORD=admin

JWT_SECRET=change-this-to-a-secure-256-bit-key-in-production
ADMIN_BOOTSTRAP_TOKEN=your-secure-bootstrap-token
ADMIN_API_TOKEN=your-secure-admin-api-token

LOG_LEVEL=info

PUBLIC_BASE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost

PROWORK_DATA_DIR=/data/prowork
