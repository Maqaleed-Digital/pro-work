# WO-WC-DEPLOY-001 — RDS Postgres + secrets. No secret VALUES in code: passwords
# are generated by random_password at apply and stored only in Secrets Manager
# (+ terraform state, which is gitignored). The app reads DATABASE_URL and
# ADMIN_API_TOKEN from these secrets via ECS task `secrets` (valueFrom).

resource "random_password" "db" {
  length  = 32
  special = false
}

resource "random_password" "admin_api_token" {
  length  = 40
  special = false
}

resource "aws_db_subnet_group" "main" {
  name       = "workcaptain-db"
  subnet_ids = data.aws_subnets.private.ids
}

resource "aws_db_instance" "main" {
  identifier              = "workcaptain-prod"
  engine                  = "postgres"
  engine_version          = "16"
  instance_class          = var.db_instance_class
  allocated_storage       = 20
  max_allocated_storage   = 100
  storage_encrypted       = true
  db_name                 = "prowork"
  username                = "prowork"
  password                = random_password.db.result
  db_subnet_group_name    = aws_db_subnet_group.main.name
  vpc_security_group_ids  = [aws_security_group.rds.id]
  multi_az                = false
  publicly_accessible     = false
  backup_retention_period = 7
  deletion_protection     = true
  skip_final_snapshot     = false
  final_snapshot_identifier = "workcaptain-prod-final"
  apply_immediately       = false
}

locals {
  database_url = "postgresql://prowork:${random_password.db.result}@${aws_db_instance.main.address}:5432/prowork"
}

resource "aws_secretsmanager_secret" "database_url" {
  name = "workcaptain/runtime/DATABASE_URL"
}
resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id     = aws_secretsmanager_secret.database_url.id
  secret_string = local.database_url
}

resource "aws_secretsmanager_secret" "admin_api_token" {
  name = "workcaptain/runtime/ADMIN_API_TOKEN"
}
resource "aws_secretsmanager_secret_version" "admin_api_token" {
  secret_id     = aws_secretsmanager_secret.admin_api_token.id
  secret_string = random_password.admin_api_token.result
}
