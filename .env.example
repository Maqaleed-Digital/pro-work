# ProWork Environment Configuration
# Copy to .env and customize for your environment

# ======================
# Application Settings
# ======================
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3010
SERVICE_NAME=prowork-api

# ======================
# Database (PostgreSQL)
# ======================
DATABASE_URL=postgresql://prowork:your_secure_password@localhost:5432/prowork
POSTGRES_USER=prowork
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=prowork

# ======================
# Cache (Redis)
# ======================
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# ======================
# Authentication
# ======================
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRY=86400
ADMIN_BOOTSTRAP_TOKEN=your-bootstrap-token-for-initial-setup

# ======================
# Security
# ======================
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
MAX_BODY_SIZE=1048576

# ======================
# Logging
# ======================
LOG_LEVEL=info
LOG_FORMAT=json

# ======================
# Feature Flags
# ======================
WOS_PUBLIC_WRITE=false

# ======================
# External Services
# ======================
# SENTRY_DSN=https://...@sentry.io/...
# DATADOG_API_KEY=...

# ======================
# AWS (for deployment)
# ======================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ======================
# Build Info
# ======================
GIT_COMMIT=unknown
