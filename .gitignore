# --- ProWork mandatory ignores (S13 baseline) ---

# Generated evidence & artifacts
exports/
evidence/
.wip/

# Runtime-generated app data
app/.runtime/

# Per-tenant persistence (do not commit runtime data)
data/tenants/

# Node artifacts
node_modules/
npm-debug.log*

# OS / editor noise
.DS_Store
.vscode/

app/server.js.bak.*

# S35: runtime data — managed via PROWORK_DATA_DIR in production
app/data/tenants.json
app/data/scheduler.json
app/data/analytics_snapshots.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
infrastructure/gcp/env/dev/dev.tfvars
infrastructure/gcp/local_backend_override.tf

# web-assurance: CI run output is uploaded as an artifact, never committed
assurance-runs/

# --- Environment files: content boundary, not filename shape -------------------
# Added 25 Aug 2026. This repository previously had NO env ignore rule at all.
# Principle: filename shape does not decide whether a file is a secret; content
# does. Templates and governed non-secret files are explicitly retained, and
# secret SCANNING (.gitleaks.toml + .github/workflows/secret-scan.yml) enforces
# the content boundary.

# Local and secret env files — never committed
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template
*.local.env
*.secret.env
*secrets.env

# Credential material — never committed, any location
*.pem
*.p12
*.pfx
*.keystore
**/service-account*.json
**/gha-creds-*.json
.docker/config.json
