# --- ProWork mandatory ignores (S13 baseline) ---

# Generated evidence & artifacts
exports/
evidence/
.wip/

# Runtime-generated app data
app/.runtime/

# Per-tenant persistence (do not commit runtime data)
data/tenants/

# Node artifacts
node_modules/
npm-debug.log*
package-lock.json

# OS / editor noise
.DS_Store
.vscode/

app/server.js.bak.*

# S35: runtime data — managed via PROWORK_DATA_DIR in production
app/data/tenants.json
app/data/scheduler.json
app/data/analytics_snapshots.json

# Runtime-generated append-only audit log (not committed)
app/data/authz_audit.jsonl

# Docker local environment overrides (not committed)
infrastructure/docker/.env
app/data/tenants/
prowork_runtime/web/.next/
prowork_runtime/web/.wave2_backup_*/
prowork_runtime/api/data/phase*.json
