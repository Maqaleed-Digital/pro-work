[Unit]
Description=ProWork API Server
Documentation=https://github.com/Maqaleed-Digital/pro-work
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=prowork
Group=prowork
WorkingDirectory=/opt/prowork/app
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prowork

# Environment — copy .env.production.example to /etc/prowork/prowork.env and fill in values
EnvironmentFile=/etc/prowork/prowork.env
Environment=NODE_ENV=production

# Systemd hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=
RestrictNamespaces=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
