# ProWork production environment template
# Copy to /etc/prowork/prowork.env (referenced by deploy/systemd/prowork.service)
# Fill in real values — never commit this file with actual secrets.

# ── Required in production (validated at startup) ───────────────────────────

# Canonical port (also set APP_PORT to the same value)
PORT=3010

# Admin API token — strong random string, minimum 32 characters
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-a-strong-random-secret-min-32-chars

# Comma-separated list of allowed CORS Origins (exact match, no wildcards)
CORS_ALLOWED_ORIGINS=https://your.domain.example

# Runtime data directory — must exist and be writable by the prowork user
# All tenant data, registry, scheduler state, and analytics are stored here.
PROWORK_DATA_DIR=/var/data/prowork

# Public base URL for this deployment (used in links and CORS validation)
PUBLIC_BASE_URL=https://your.domain.example

# ── Server binding ───────────────────────────────────────────────────────────

# Nginx terminates TLS and proxies to this address; keep 127.0.0.1 in production
APP_HOST=127.0.0.1
APP_PORT=3010

# ── Proxy / networking ───────────────────────────────────────────────────────

# Set to 1 when behind nginx or another reverse proxy to trust X-Forwarded-For
# for accurate client IP addresses (used in rate limiting)
TRUSTED_PROXY=1

# ── Runtime ──────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# Git commit SHA injected at deploy time (shown in /api/health)
GIT_COMMIT=

# Scheduler interval in milliseconds (default: 30000 = 30s)
SCHEDULER_INTERVAL_MS=30000

# Set to true only if WOS write endpoints should be publicly accessible without auth
WOS_PUBLIC_WRITE=false
