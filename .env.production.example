# ProWork production environment template
# Copy to /etc/prowork/prowork.env (referenced by deploy/systemd/prowork.service)
# Fill in real values — never commit this file with actual secrets.

NODE_ENV=production
PORT=3010

PUBLIC_BASE_URL=https://your-domain.com

# Comma-separated list of allowed CORS Origins (exact match, no wildcards)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Admin API token — strong random string, minimum 32 characters
# Generate: openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-long-random-secret

# Runtime data directory — must exist and be writable by the prowork user
PROWORK_DATA_DIR=/var/data/prowork

LOG_LEVEL=info

# Set to true when behind nginx or another reverse proxy (trusts X-Forwarded-For)
TRUSTED_PROXY=true

# Rate limiting — requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
ADMIN_RATE_LIMIT_MAX_REQUESTS=60

# Maximum JSON body size in bytes (default: 524288 = 512 KiB)
JSON_BODY_LIMIT=524288

# Set to true only if WOS write endpoints should be publicly accessible without auth
WOS_PUBLIC_WRITE=false
